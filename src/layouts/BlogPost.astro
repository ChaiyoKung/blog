---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Layout from "./Layout.astro";
import Prose from "../components/Prose.astro";
import BlogCardTag from "../components/BlogCardTag.astro";
import ViewCount from "../components/ViewCount.astro";
import { SITE_TITLE } from "../consts";
import { toLocale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import type { TranslatedUrls } from "../i18n/utils";

type Props = CollectionEntry<"blog">["data"] & {
  translatedUrls: TranslatedUrls;
};

const {
  title,
  description,
  createdAt,
  updatedAt,
  heroImage,
  tags,
  translatedUrls,
} = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
---

<Layout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  image={heroImage}
  translatedUrls={translatedUrls}
>
  <article>
    <div class="mb-4">
      <BlogCardTag tags={tags} />
    </div>

    <h1 class="text-6xl font-bold text-gray-800 dark:text-gray-100 mb-4">
      {title}
    </h1>

    <div class="flex flex-row justify-between items-center mb-4">
      <div class="text-sm text-gray-500 dark:text-gray-400">
        {t("post.updatedOn")}
        <FormattedDate date={updatedAt ?? createdAt} />
      </div>

      <ViewCount />
    </div>

    <div class="mb-4">
      <div class="aspect-video bg-gray-400 rounded-lg overflow-hidden">
        <img
          src={heroImage}
          alt={`${title} ${t("post.altSuffix")}`}
          class="object-cover w-full h-full"
        />
      </div>
    </div>

    <hr class="border-gray-200 dark:border-gray-700 my-12" />

    <Prose>
      <slot />
    </Prose>
  </article>
</Layout>
