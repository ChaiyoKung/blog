---
import type { CollectionEntry } from "astro:content";
import BlogCardTag from "./BlogCardTag.astro";
import FormattedDate from "./FormattedDate.astro";
import { useTranslations } from "../i18n/ui";
import { getBlogLocale, getBlogSlug, localePath } from "../i18n/utils";

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const locale = getBlogLocale(blog.id);
const t = useTranslations(locale);
---

<div class="grid grid-cols-12 gap-4">
  <div
    class="col-span-12 sm:col-span-6 md:col-span-5 lg:col-span-4 aspect-video bg-gray-400 rounded-lg overflow-hidden"
  >
    <img
      src={blog.data.heroImage}
      alt={`${blog.data.title} ${t("post.altSuffix")}`}
      class="object-cover w-full h-full"
    />
  </div>
  <div class="col-span-12 sm:col-span-6 md:col-span-7 lg:col-span-8">
    <BlogCardTag tags={blog.data.tags} />
    <a href={localePath(locale, `blog/${getBlogSlug(blog.id)}/`)}>
      <h4 class="text-xl font-bold text-gray-800 my-2 transition duration-100">
        {blog.data.title}
      </h4>
      <p class="text-gray-600 mb-4">{blog.data.description}</p>
      <div class="flex items-center text-sm text-gray-500">
        <FormattedDate date={blog.data.createdAt} />
      </div>
    </a>
  </div>
</div>
