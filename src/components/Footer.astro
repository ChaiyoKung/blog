---
import GitHubLink from "./GitHubLink.astro";
import LinkedInLink from "./LinkedInLink.astro";
import RssLink from "./RssLink.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="bg-gray-800 text-gray-400 dark:bg-night-800">
  <div class="container mx-auto px-4 py-8 flex flex-col items-center space-y-4">
    <div class="flex items-center space-x-4">
      <GitHubLink class="text-gray-400 hover:text-white" />
      <LinkedInLink class="text-gray-400 hover:text-white" />
      <RssLink locale={locale} class="text-gray-400 hover:text-white" />
    </div>
    <div>&copy; ChaiyoKung</div>
  </div>
</footer>
