---
import type { CollectionEntry } from "astro:content";
import { toLocale } from "../i18n/config";
import { localePath } from "../i18n/utils";
import { tagToSlug } from "../utils/tagToSlug";

interface Props {
  tags: CollectionEntry<"blog">["data"]["tags"];
}

const { tags } = Astro.props;
const locale = toLocale(Astro.currentLocale);

if (!tags || tags.length === 0) {
  return null;
}
---

<div class="flex items-center flex-wrap space-x-2 text-sm">
  {
    tags.map((tag, index) => (
      <>
        {index !== 0 && <span class="text-gray-400">•</span>}
        <a
          href={localePath(locale, `tags/${tagToSlug(tag)}`)}
          class="text-blue-600 hover:text-blue-800"
        >
          {tag}
        </a>
      </>
    ))
  }
</div>
