---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import LinkedInLink from "./LinkedInLink.astro";
import GitHubLink from "./GitHubLink.astro";
import RssLink from "./RssLink.astro";
---

<header
  class="bg-white/75 sticky top-0 z-50 backdrop-blur border-b border-gray-200"
>
  <nav class="container mx-auto p-4">
    <div class="sm:flex justify-between items-center">
      <div class="flex justify-between items-center">
        <a href="/">
          <h2 class="text-xl font-bold text-gray-800">
            {SITE_TITLE}
          </h2>
        </a>

        <button
          type="button"
          id="header-menu-button"
          class="sm:hidden flex justify-center items-center text-gray-600 hover:text-gray-800 cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 6l16 0"></path>
            <path d="M4 12l16 0"></path>
            <path d="M4 18l16 0"></path>
          </svg>
        </button>
      </div>

      <div
        id="header-menu"
        class="hidden sm:flex items-center space-y-4 sm:space-y-0 sm:space-x-8 mt-4 sm:mt-0"
      >
        <div
          class="flex flex-col sm:flex-row item-center space-y-2 sm:space-y-0 sm:space-x-4"
        >
          <HeaderLink href="/">Home</HeaderLink>
          <HeaderLink href="/blog">Blog</HeaderLink>
          <HeaderLink href="/about">About</HeaderLink>
        </div>

        <div class="flex items-center space-x-4">
          <GitHubLink class="text-gray-600 hover:text-gray-800" />
          <LinkedInLink class="text-gray-600 hover:text-gray-800" />
          <RssLink class="text-gray-600 hover:text-gray-800" />
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  document
    .getElementById("header-menu-button")!
    .addEventListener("click", () => {
      const menu = document.getElementById("header-menu")!;
      menu.classList.toggle("hidden");
    });
</script>
