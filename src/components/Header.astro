---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import SearchLink from "./SearchLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { localePath } from "../i18n/utils";

interface Props {
  locale: Locale;
  languageUrls: Record<Locale, string>;
}

const { locale, languageUrls } = Astro.props;
const t = useTranslations(locale);
---

<header
  class="bg-white/75 dark:bg-night-900/75 sticky top-0 z-50 backdrop-blur border-b border-gray-200 dark:border-night-700"
>
  <nav class="container mx-auto p-4">
    <div class="md:flex justify-between items-center">
      <div class="flex justify-between items-center">
        <a href={localePath(locale)}>
          <h2 class="text-xl font-bold text-gray-800 dark:text-night-100">
            {SITE_TITLE}
          </h2>
        </a>

        <div class="md:hidden flex items-center space-x-4">
          <ThemeToggle
            locale={locale}
            class="text-gray-600 hover:text-gray-800 dark:text-night-400 dark:hover:text-night-100"
          />
          <button
            type="button"
            id="header-menu-button"
            class="flex justify-center items-center text-gray-600 hover:text-gray-800 dark:text-night-400 dark:hover:text-night-100 cursor-pointer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M4 6l16 0"></path>
              <path d="M4 12l16 0"></path>
              <path d="M4 18l16 0"></path>
            </svg>
          </button>
        </div>
      </div>

      <div
        id="header-menu"
        class="hidden md:flex items-center space-y-4 md:space-y-0 md:space-x-8 mt-4 md:mt-0"
      >
        <div class="flex items-center space-x-4">
          <SearchLink
            locale={locale}
            class="text-gray-600 hover:text-gray-800 dark:text-night-400 dark:hover:text-night-100"
          />
        </div>

        <div
          class="flex flex-col md:flex-row item-center space-y-2 md:space-y-0 md:space-x-4"
        >
          <HeaderLink href={localePath(locale)}>{t("nav.home")}</HeaderLink>
          <HeaderLink href={localePath(locale, "blog")}>
            {t("nav.blog")}
          </HeaderLink>
          <HeaderLink href={localePath(locale, "about")}>
            {t("nav.about")}
          </HeaderLink>
        </div>

        <LanguageSwitcher locale={locale} urls={languageUrls} />

        <ThemeToggle
          locale={locale}
          class="hidden md:block text-gray-600 hover:text-gray-800 dark:text-night-400 dark:hover:text-night-100"
        />
      </div>
    </div>
  </nav>
</header>

<script>
  document
    .getElementById("header-menu-button")!
    .addEventListener("click", () => {
      const menu = document.getElementById("header-menu")!;
      menu.classList.toggle("hidden");
    });
</script>
