---
import type { HTMLAttributes } from "astro/types";
import { splitLocalePath } from "../i18n/utils";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const trimSlashes = (path: string) => path.replace(/^\/+|\/+$/g, "");
const currentPath = trimSlashes(splitLocalePath(Astro.url.pathname).path);
const linkPath = trimSlashes(splitLocalePath(String(href)).path);
const isActive =
  linkPath === ""
    ? currentPath === ""
    : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
---

<a
  href={href}
  class:list={[
    {
      "text-gray-600 hover:text-gray-800": !isActive,
      "text-blue-600 hover:text-blue-800": isActive,
    },
    "font-medium",
    className,
  ]}
  {...props}
>
  <slot />
</a>
