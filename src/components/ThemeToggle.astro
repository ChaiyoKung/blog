---
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  data-theme-toggle
  aria-label={t("theme.switchToDark")}
  title={t("theme.switchToDark")}
  data-label-light={t("theme.switchToLight")}
  data-label-dark={t("theme.switchToDark")}
  class:list={["cursor-pointer", className]}
>
  <!-- Sun icon: shown in dark mode, so a click switches to light. -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden dark:block"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <!-- Moon icon: shown in light mode, so a click switches to dark. -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="block dark:hidden"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  import {
    DARK_CLASS,
    DARK_MEDIA_QUERY,
    DARK_THEME,
    getOppositeTheme,
    LIGHT_THEME,
    resolveTheme,
    THEME_STORAGE_KEY,
    THEME_TOGGLE_SELECTOR,
  } from "../utils/theme";

  const root = document.documentElement;

  function currentTheme() {
    return root.classList.contains(DARK_CLASS) ? DARK_THEME : LIGHT_THEME;
  }

  function updateButtons() {
    const theme = currentTheme();
    document
      .querySelectorAll<HTMLButtonElement>(THEME_TOGGLE_SELECTOR)
      .forEach((button) => {
        // The label names the action: the theme the click switches to.
        const label =
          theme === DARK_THEME
            ? button.dataset.labelLight
            : button.dataset.labelDark;
        button.setAttribute("aria-label", label ?? "");
        button.title = label ?? "";
      });
  }

  document
    .querySelectorAll<HTMLButtonElement>(THEME_TOGGLE_SELECTOR)
    .forEach((button) => {
      button.addEventListener("click", () => {
        const nextTheme = getOppositeTheme(currentTheme());
        root.classList.toggle(DARK_CLASS, nextTheme === DARK_THEME);
        try {
          localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
        } catch {
          // Storage can be blocked. The theme still changes for this visit.
        }
        updateButtons();
      });
    });

  // Follow the system setting while the user has not chosen a theme.
  window.matchMedia(DARK_MEDIA_QUERY).addEventListener("change", (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(THEME_STORAGE_KEY);
    } catch {
      // Treat blocked storage as "no saved choice".
    }
    const theme = resolveTheme(stored, event.matches);
    root.classList.toggle(DARK_CLASS, theme === DARK_THEME);
    updateButtons();
  });

  updateButtons();
</script>
