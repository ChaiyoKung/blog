---
const { host } = new URL(Astro.site ?? Astro.url);
const path = Astro.url.pathname.replace(/\/+$/, "");
const hitsUrl = `https://hits.sh/${host}${path}.svg?label=views&color=155dfc&labelColor=f3f4f6&style=flat`;
---

{
  import.meta.env.PROD && (
    <img src={hitsUrl} alt="View count" height="20" loading="lazy" />
  )
}
