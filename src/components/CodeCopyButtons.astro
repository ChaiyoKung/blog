---
import { toLocale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(toLocale(Astro.currentLocale));

const iconProps = {
  xmlns: "http://www.w3.org/2000/svg",
  width: "18",
  height: "18",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
};
---

<!-- The script clones this bar into every code block. -->
<template
  data-code-copy-template
  data-label-idle={t("code.copy")}
  data-label-copied={t("code.copied")}
  data-label-failed={t("code.copyFailed")}
>
  <div
    class="flex items-center justify-between border-b border-white/10 py-1 pr-2 pl-4 font-mono text-xs text-gray-400"
    data-pagefind-ignore
  >
    <span data-code-language></span>
    <button
      type="button"
      data-code-copy-button
      data-state="idle"
      class="group flex size-8 cursor-pointer items-center justify-center rounded-md text-gray-400 hover:bg-white/10 hover:text-gray-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-night-link data-[state=copied]:text-green-400 data-[state=failed]:text-red-400"
    >
      <!-- Tabler Icons: copy, check, x. Only the icon for the state shows. -->
      <svg
        {...iconProps}
        class="hidden group-data-[state=idle]:block"
        data-icon="copy"
      >
        <path
          d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
        ></path>
        <path
          d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
        ></path>
      </svg>
      <svg
        {...iconProps}
        class="hidden group-data-[state=copied]:block"
        data-icon="check"
      >
        <path d="M5 12l5 5l10 -10"></path>
      </svg>
      <svg
        {...iconProps}
        class="hidden group-data-[state=failed]:block"
        data-icon="x"
      >
        <path d="M18 6l-12 12"></path>
        <path d="M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</template>

<!-- Screen readers hear the result of a copy here. -->
<div class="sr-only" aria-live="polite" data-code-copy-status></div>

<script>
  import {
    CODE_BLOCK_SELECTOR,
    COPY_FEEDBACK_MS,
    copyText,
    getCodeLanguage,
    getCodeText,
    type CopyState,
  } from "../utils/codeCopy";

  const template = document.querySelector<HTMLTemplateElement>(
    "[data-code-copy-template]"
  );
  const status = document.querySelector<HTMLElement>("[data-code-copy-status]");

  const labels: Record<CopyState, string> = {
    idle: template?.dataset.labelIdle ?? "",
    copied: template?.dataset.labelCopied ?? "",
    failed: template?.dataset.labelFailed ?? "",
  };

  function addCopyBar(pre: HTMLElement, barTemplate: HTMLTemplateElement) {
    const bar = barTemplate.content.firstElementChild?.cloneNode(true);
    if (!(bar instanceof HTMLElement)) return;

    const button = bar.querySelector<HTMLButtonElement>(
      "[data-code-copy-button]"
    );
    const language = bar.querySelector<HTMLElement>("[data-code-language]");
    if (!button || !language) return;

    // The bar uses the same background as the code, so they look like one box.
    bar.style.backgroundColor = pre.style.backgroundColor;
    language.textContent = getCodeLanguage(pre);

    // The wrapper clips the corners. The bar stays still when the code scrolls.
    const wrapper = document.createElement("div");
    wrapper.className = "my-6 overflow-hidden rounded-lg";
    // `!` is needed because the prose styles for `pre` come later in the CSS.
    pre.classList.add("my-0!", "rounded-none!");
    pre.replaceWith(wrapper);
    wrapper.append(bar, pre);

    let resetTimer: number | undefined;

    function setState(state: CopyState) {
      if (!button) return;
      button.dataset.state = state;
      button.setAttribute("aria-label", labels[state]);
      button.title = labels[state];
      if (status) status.textContent = state === "idle" ? "" : labels[state];
    }

    setState("idle");

    button.addEventListener("click", async () => {
      const copied = await copyText(getCodeText(pre));
      setState(copied ? "copied" : "failed");
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => setState("idle"), COPY_FEEDBACK_MS);
    });
  }

  if (template) {
    document
      .querySelectorAll<HTMLElement>(CODE_BLOCK_SELECTOR)
      .forEach((pre) => addCopyBar(pre, template));
  }
</script>
