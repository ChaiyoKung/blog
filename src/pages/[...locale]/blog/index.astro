---
import { SITE_TITLE } from "../../../consts";
import Layout from "../../../layouts/Layout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { toLocale } from "../../../i18n/config";
import { getLocaleStaticPaths } from "../../../i18n/staticPaths";
import { useTranslations } from "../../../i18n/ui";
import { getBlogsByLocale } from "../../../utils/getBlogsByLocale";
import { sortBlogCollectionByCreatedAt } from "../../../utils/sortBlogCollectionByCreatedAt";

export const getStaticPaths = getLocaleStaticPaths;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const blogs = await getBlogsByLocale(locale);
const sortedBlogs = sortBlogCollectionByCreatedAt(blogs, "desc");
---

<Layout
  title={`${t("nav.blog")} | ${SITE_TITLE}`}
  description={t("site.description")}
>
  <div class="flex flex-col space-y-8">
    {sortedBlogs.map((blog) => <BlogCard blog={blog} />)}
  </div>
</Layout>
